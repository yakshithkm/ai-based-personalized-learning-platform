PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/learning_platform
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=http://127.0.0.1:8000
CLIENT_URL=http://localhost:5173

# Ask with AI (Practice Page doubt-resolution sidebar) - Google Gemini API,
# free tier. Server-side only - never referenced from the frontend. Get a
# key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Admin portal login (see backend/src/utils/adminBootstrap.js). On server start,
# a User document with this email is created/updated with isAdmin=true and this
# password (bcrypt-hashed via the existing User model - never stored in plaintext,
# never returned by any API, never referenced from the frontend). Change the
# password here and restart the server (or run `npm run seed:admin`) to rotate it.
ADMIN_EMAIL=admin@learning.com
ADMIN_PASSWORD=change_me_before_using
ADMIN_NAME=Platform Admin

# Learning-content recommendations. The engine is fully deterministic and needs NO key.
# Set to true (and provide GEMINI_API_KEY above) to let Gemini optionally rephrase the single
# top "why this is recommended" sentence. Off by default; failures silently fall back to the
# rule-based explanation.
LEARNING_AI_EXPLANATIONS=false

# Login confirmation email (functionality 3) - sent after every successful
# student login via a plain SMTP transport (nodemailer). Leave SMTP_HOST unset
# to disable email sending entirely; login always succeeds regardless of
# whether these are configured or whether sending succeeds.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=